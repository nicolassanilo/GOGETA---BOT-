# Variables de entorno para GOGETA-BOT
# Copia este archivo como .env y ajusta los valores

# Entorno de ejecución
NODE_ENV=production

# Puerto del servidor web
PORT=3000

# Número del owner del bot (con código de país, sin espacios ni guiones)
OWNER_NUMBER=5492604035392

# Nombre del bot (opcional)
BOT_NAME=Gogeta-Bot

# Configuración de sesión (opcional)
SESSION_PATH=./sessions

# Configuración de base de datos (opcional)
DATABASE_PATH=./data
